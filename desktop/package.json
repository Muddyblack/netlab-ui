{
  "name": "netlab-ui-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron shell for netlab-ui — points at a running netlab-ui backend (local or remote), bundles no backend of its own.",
  "author": {
    "name": "Muddyblack",
    "url": "https://github.com/Muddyblack"
  },
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "check": "npm run lint && npm test",
    "lint": "oxlint src test",
    "test": "node --test",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.92.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.4",
      "@electron/asar": {
        "minimatch": "3.1.5"
      },
      "@electron/universal": {
        "dir-compare": {
          "minimatch": "3.1.5"
        }
      },
      "ejs": {
        "minimatch": "5.1.9"
      }
    }
  },
  "build": {
    "appId": "app.netlab.desktop",
    "productName": "netlab-ui",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/*.map"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
