[Unit]
Description=netlab-gui Service (Autostart on boot)
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
# Default assumes a checkout at ~/netlab_gui. Don't edit this file for your own
# path; override it locally instead:
#   systemctl --user edit netlab-gui
#   [Service]
#   WorkingDirectory=/path/to/netlab_gui
WorkingDirectory=%h/netlab_gui
ExecStart=/usr/bin/env nix run
Restart=always
RestartSec=5s
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
