{
  "name": "netlab-gui-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api/generated.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@containerlab/clab-ui": "0.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@mui/x-charts": "9.16.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.4.1",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "patch-package": "^8.0.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "maplibre-gl": "6.10.0",
    "markdown-it": "14.3.3",
    "minimatch": "10.2.6"
  }
}
