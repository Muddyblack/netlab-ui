{
  "name": "netlab-gui-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api/generated.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.27",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@srl-labs/clab-ui": "^0.0.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "monaco-editor": "^0.56.0",
    "monaco-yaml": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.4.0",
    "oxlint": "^1.74.0",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "vite": "^8.1.5"
  }
}
